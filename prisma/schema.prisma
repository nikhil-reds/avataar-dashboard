// This is your Prisma schema file for Avataar HeyGen Admin Console
// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User / Admin Accounts
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// Product Catalogue SKUs
model ProductSku {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  category      String
  price         Decimal  @db.Decimal(12, 2)
  weight        String?
  makingCharge  String?
  stock         Int      @default(0)
  supplier      String?
  talkingPoints String[] @default([])
  source        String   @default("Manual")
  state         SkuState @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_skus")
}

enum SkuState {
  LIVE
  REVIEW
  DRAFT
}

// Observability & Request Logs
model ActivityLog {
  id        String   @id @default(uuid())
  time      String
  event     String
  session   String
  model     String
  latency   String
  kind      LogKind
  status    String
  cost      Decimal? @db.Decimal(8, 2)
  tokensIn  Int?
  tokensOut Int?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

enum LogKind {
  CHAT
  RENDER
  INGEST
}

// PDF Ingest Extraction Jobs
model IngestJob {
  id             String         @id @default(uuid())
  file           String
  state          IngestJobState @default(QUEUED)
  pct            String         @default("0%")
  note           String?
  page           Int            @default(1)
  totalPages     Int?
  extractedRows  ExtractedRow[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("ingest_jobs")
}

enum IngestJobState {
  QUEUED
  EXTRACTING
  DONE
  FAILED
}

// Extracted PDF Rows (Human-in-the-Loop Review)
model ExtractedRow {
  id        String        @id @default(uuid())
  jobId     String
  job       IngestJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  conf      String
  fields    Json          // Key-value attributes (sku, price, weight, making)
  verdict   ReviewVerdict @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("extracted_rows")
}

enum ReviewVerdict {
  PENDING
  APPROVED
  REJECTED
}

// HeyGen Avatar Video Renders
model AvatarRender {
  id        String       @id @default(uuid())
  script    String       @db.Text
  voice     String
  length    String?
  state     RenderState  @default(QUEUED)
  videoUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("avatar_renders")
}

enum RenderState {
  QUEUED
  RENDERING
  DONE
  FAILED
}

// Conversational Shopper Memory Store
model ShopperSession {
  id        String         @id @default(uuid())
  sessionId String         @unique
  name      String
  summary   String?
  ttl       String
  fresh     Boolean        @default(true)
  turns     SessionTurn[]
  facts     RetainedFact[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("shopper_sessions")
}

// Chat Turns in Session
model SessionTurn {
  id        String         @id @default(uuid())
  sessionId String
  session   ShopperSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  who       SpeakerRole
  text      String         @db.Text
  time      String
  createdAt DateTime       @default(now())

  @@map("session_turns")
}

enum SpeakerRole {
  SHOPPER
  AVATAR
  SYSTEM
}

// Extracted Facts Retained per Shopper
model RetainedFact {
  id        String         @id @default(uuid())
  sessionId String
  session   ShopperSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key       String
  value     String
  exp       String
  createdAt DateTime       @default(now())

  @@map("retained_facts")
}
