// This is your Prisma schema file for Avataar HeyGen Admin Console
// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User / Admin Accounts
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// Product Catalogue SKUs
model ProductSku {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  category      String
  price         Decimal  @db.Decimal(12, 2)
  weight        String?
  makingCharge  String?
  stock         Int      @default(0)
  supplier      String?
  talkingPoints String[] @default([])
  source        String   @default("Manual")
  state         SkuState @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_skus")
}

enum SkuState {
  LIVE
  REVIEW
  DRAFT
}

// Observability & Request Logs
// Written by lib/activity.ts from the real request paths. Every field is a measurement,
// not a label: latency is milliseconds actually elapsed, tokens come from the provider.
model ActivityLog {
  id        String    @id @default(uuid())
  event     String
  kind      LogKind
  status    LogStatus @default(OK)
  sessionId String?
  model     String?
  latencyMs Int?
  cost      Decimal?  @db.Decimal(10, 4)
  tokensIn  Int?
  tokensOut Int?
  detail    String?
  createdAt DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@map("activity_logs")
}

enum LogKind {
  CHAT
  RENDER
  INGEST
  SESSION
}

enum LogStatus {
  OK
  ERROR
  ESCALATED
}

// PDF Ingest Extraction Jobs
model IngestJob {
  id            String         @id @default(uuid())
  file          String
  state         IngestJobState @default(QUEUED)
  pct           Int            @default(0)
  note          String?
  page          Int            @default(1)
  totalPages    Int?
  extractedRows ExtractedRow[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("ingest_jobs")
}

enum IngestJobState {
  QUEUED
  EXTRACTING
  DONE
  FAILED
}

// Extracted PDF Rows (Human-in-the-Loop Review)
model ExtractedRow {
  id        String        @id @default(uuid())
  jobId     String
  job       IngestJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  conf      String
  fields    Json // Key-value attributes (sku, price, weight, making)
  verdict   ReviewVerdict @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("extracted_rows")
}

enum ReviewVerdict {
  PENDING
  APPROVED
  REJECTED
}

// HeyGen Avatar Video Renders
model AvatarRender {
  id          String      @id @default(uuid())
  script      String      @db.Text
  voice       String
  durationSec Int?
  state       RenderState @default(QUEUED)
  videoUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("avatar_renders")
}

enum RenderState {
  QUEUED
  RENDERING
  DONE
  FAILED
}

// Conversational Shopper Memory Store
// One row per avatar conversation. Denormalised turnCount/durationSec exist so the
// admin console can sort on them with an index instead of a computed aggregate.
model ShopperSession {
  id              String         @id @default(uuid())
  // HeyGen LiveAvatar session id (`session.sessionId`), for correlating back to their dashboard.
  avatarSessionId String?        @unique
  // Derived from the shopper's first question once it arrives.
  title           String?
  summary         String?
  status          SessionStatus  @default(LIVE)
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  durationSec     Int?
  turnCount       Int            @default(0)
  lastTurnAt      DateTime?
  expiresAt       DateTime?
  locale          String?
  turns           SessionTurn[]
  facts           RetainedFact[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([turnCount(sort: Desc)])
  @@map("shopper_sessions")
}

enum SessionStatus {
  LIVE
  ENDED
  ERROR
}

// Chat Turns in Session
// `seq` is assigned client-side and is the authoritative ordering: batched turns can
// share a timestamp, so ordering on time alone would eventually put an answer above
// its question. `eventId` is the SDK's event_id, making retried flushes idempotent.
model SessionTurn {
  id        String         @id @default(uuid())
  sessionId String
  session   ShopperSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  eventId   String         @unique
  who       SpeakerRole
  text      String         @db.Text
  spokenAt  DateTime
  createdAt DateTime       @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
  @@map("session_turns")
}

enum SpeakerRole {
  SHOPPER
  AVATAR
  SYSTEM
}

// Extracted Facts Retained per Shopper
model RetainedFact {
  id        String         @id @default(uuid())
  sessionId String
  session   ShopperSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key       String
  value     String
  expiresAt DateTime?
  createdAt DateTime       @default(now())

  @@index([sessionId])
  @@map("retained_facts")
}

// Avatar Knowledge Base
// The avatar's answers are grounded in these rows and nothing else. Written from the
// admin console at /admin/knowledge and read back per-question by lib/knowledgeRetrieval.ts,
// so new knowledge is live on the next question without a rebuild.
//
// `keywords` is an array rather than a delimited string to match ProductSku.talkingPoints
// and to let retrieval match a whole term instead of a substring of one.
model AvatarKnowledge {
  id        String   @id @default(uuid())
  title     String?
  content   String   @db.Text
  category  String?
  keywords  String[] @default([])
  source    String?
  isActive  Boolean  @default(true)
  // Stable identity for a row that came from the seed import. Lets the import script be
  // re-run without duplicating what it inserted last time. Null for hand-entered rows.
  importKey String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Retrieval reads active rows only, newest first; the admin list filters by category.
  @@index([isActive, updatedAt(sort: Desc)])
  @@index([category])
  @@map("avatar_knowledge")
}
